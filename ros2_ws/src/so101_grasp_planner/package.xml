<?xml version="1.0"?>
<package format="3">
  <name>so101_grasp_planner</name>
  <version>0.1.0</version>

  <description>
    Dry-run visual grasp planning for SO-101 using top-down IK preview trajectories.
  </description>

  <maintainer email="maintainer@example.com">
    so101_visual_tactile_grasp
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>so101_kinematics</exec_depend>
  <exec_depend>so101_frame_transform</exec_depend>
  <exec_depend>so101_object_perception</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
